<section class="flex flex-col items-center justify-center bg-gray-50 py-12">
    <div class="bg-white p-8 rounded-lg shadow-lg max-w-md w-full">
        <h2 class="text-3xl font-bold text-gray-800 text-center mb-2">
            ¿Estás interesado?
        </h2>

        <p class="text-gray-600 text-center mb-6">
            Uno de nuestros asesores te contactará
        </p>

        <form class="space-y-6">
            <div>
                <input
                    type="email"
                    id="email"
                    placeholder="Ingresa tu correo electrónico"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#A8E6CF] focus:border-transparent"
                    required
                />
            </div>

            <button
                type="submit"
                class="w-full bg-[#A8E6CF] text-white py-2 px-4 rounded-lg hover:bg-[#8FD3B2] transition-colors duration-300 cursor-pointer"
            >
                Enviar
            </button>
        </form>
    </div>
</section>
